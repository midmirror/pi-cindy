{
  "name": "pi-cindy",
  "version": "0.5.2",
  "description": "Pi extension: Cindy device-link sync — mimics Cindy Desktop for mobile control",
  "license": "Apache-2.0",
  "author": "midmirror <midmirror@live.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/midmirror/pi-cindy.git"
  },
  "homepage": "https://github.com/midmirror/pi-cindy",
  "engines": {
    "node": ">=22.23.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "cindy",
    "device-link",
    "sync"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test && npm run typecheck",
    "test": "node tests/smoke.test.js && node tests/ownership.test.js && node tests/multi-process.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "jiti": "^2.7.0",
    "typebox": "^1.3.10",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
