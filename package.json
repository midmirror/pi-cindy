{
  "name": "pi-cindy",
  "version": "0.5.2",
  "description": "Pi extension: Cindy device-link sync — mimics Cindy Desktop for mobile control",
  "license": "Apache-2.0",
  "author": "midmirror <midmirror@live.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/midmirror/pi-cindy.git"
  },
  "homepage": "https://github.com/midmirror/pi-cindy",
  "engines": {
    "node": ">=22.23.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "cindy",
    "device-link",
    "sync"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test && npm run typecheck",
    "test": "node tests/smoke.test.js && node tests/ownership.test.js && node tests/multi-process.test.js",
    "typecheck": "tsc --noEmit",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"index.ts\" \"tests/*.js\"",
    "coverage": "c8 --include=src --reporter=text --reporter=lcov node tests/smoke.test.js && node tests/ownership.test.js && node tests/multi-process.test.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "typebox": "^1.3.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
